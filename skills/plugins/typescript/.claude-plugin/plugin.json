{
  "name": "typescript",
  "description": "TypeScript best practices: strict typing, type narrowing, and functional patterns",
  "version": "1.0.0",
  "author": {
    "name": "Kingstinct",
    "email": "robert@kingstinct.com"
  },
  "allowedTools": [
    "Bash(tsc:*)",
    "Bash(bun run tsc:*)",
    "Bash(bunx tsc:*)",
    "Bash(bun run typecheck:*)"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun run typecheck"
          }
        ]
      }
    ]
  }
}
